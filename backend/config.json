{
    "listeners": [
        {
            "address": "127.0.0.1",
            "port": 7777,
            "https": false
        }
    ],
    "db_clients": [
        {
            "rdbms": "sqlite3",
            "filename": "pastebox.db",
            "is_fast": false,
            "number_of_connections": 1,
            "timeout": 10.0
        }
    ],
    "app": {
        "number_of_threads": 4,
        "document_root": "./public",
        "home_page": "index.html",
        "upload_path": "uploads",
        "file_types": [
            "css",
            "eot",
            "gif",
            "html",
            "ico",
            "jpg",
            "js",
            "json",
            "png",
            "svg",
            "ttf",
            "txt",
            "webp",
            "woff",
            "woff2",
            "xml"
        ],
        "use_gzip": true,
        "log": {
            "log_level": "INFO"
        },
        "run_as_daemon": false,
        "use_sendfile": true,
        "idle_connection_timeout": 30,
        "client_max_body_size": "4M",
        "max_connections": 256,
        "keepalive_requests": 100,
        "pipelining_requests": 4
    }
}
